# ============================================================
# .gitignore - Git 추적에서 제외할 파일 목록
# ============================================================

# API 키가 담긴 환경변수 파일 (절대 올리지 않음!)
.env

# 파이썬 캐시 파일
__pycache__/
*.py[cod]
*.pyo

# 가상환경 폴더
venv/
.venv/
env/

# OS 시스템 파일
.DS_Store
Thumbs.db

# IDE 설정 파일
.idea/
.vscode/
*.swp

# 동기화 실행 로그 (일시적, 민감정보 없음)
sync_log.txt
sync_book_log.txt

# data/*.json은 이제 git에 커밋한다.
# GitHub Actions가 매일 sync_notion.py를 돌릴 때 증분 동기화(이미 있는 날짜는
# 건너뜀) 판단을 위해 이전 실행 결과가 저장소에 남아있어야 하고,
# build_static.py가 이 파일을 읽어 docs/data/를 생성하기 때문이다.
